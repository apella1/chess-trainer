# Copy this file to .env and fill in values. Never commit .env.

# Database
DB_USER=chess_trainer
DB_PASSWORD=changeme
DB_NAME=chess_trainer
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Stockfish (path inside the worker container)
STOCKFISH_PATH=/usr/games/stockfish

# Engine analysis settings
ANALYSIS_DEPTH=14
ANALYSIS_MULTIPV=3

# Ollama (runs on the host; accessible from containers via host.docker.internal)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
REVIEW_PROMPT_VERSION=v1

# Chess.com API (include a real contact address per their terms)
CHESSCOM_USER_AGENT=ChessTrainer/1.0 contact@example.com

# Worker poll interval in seconds
WORKER_POLL_SECONDS=5
